# ── Database ──────────────────────────────────────────────────
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=healthhub_db

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=

# ── URLs ──────────────────────────────────────────────────────
# Set to your Vercel frontend URL so patient join links are correct
FRONTEND_URL=https://your-portfolio.vercel.app

# ── Email (ConsultLink patient invite) ────────────────────────
# Use a Gmail App Password — NOT your regular Gmail password.
# Steps:
#   1. Enable 2FA on your Google account
#   2. Go to myaccount.google.com → Security → App Passwords
#   3. Generate one for "Mail / Other (custom)" → copy the 16-char password
#   4. Set EMAIL_USER to your Gmail address and EMAIL_PASS to that password
EMAIL_USER=you@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
